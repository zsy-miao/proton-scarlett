+// MinGW has the manifest-free ETW string API but not the TraceLogging SDK header.
+constexpr GUID providerId{0x2b6274b2, 0x159f, 0x4e6f, {0xb8, 0, 0x0d, 0x17, 0, 0x9e, 0x14, 0x7a}};
 
 
 // Helper method to ensure our ETW Provider never gets registered twice. Registering an ETW provider twice may result
