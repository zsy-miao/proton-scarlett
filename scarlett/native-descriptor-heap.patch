+#[cfg(test)]
+#[test]
+#[ignore = "requires Proton/vkd3d and a GPU"]
+fn native_descriptor_handles_and_lifetime() {
+    unsafe {
+        assert!(on_wine());
+        let mut dev: Option<ID3D12Device> = None;
+        D3D12CreateDevice(None, D3D_FEATURE_LEVEL_12_0, &mut dev).unwrap();
+        let dev = dev.unwrap();
+        let alloc: ID3D12CommandAllocator = dev.CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT).unwrap();
+        let list: ID3D12GraphicsCommandList = dev.CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, &alloc, None).unwrap();
+        adopt(dev.as_raw(), Kind::Device);
+        let desc = [D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER.0 as u32, 4, 1, 0];
+        let mut p = std::ptr::null_mut();
+        assert_eq!(dev_create_descriptor_heap_x(dev.as_raw(), &desc, &pc_iid(Kind::DescriptorHeap), &mut p), S_OK);
+        let view = ID3D12DescriptorHeap::from_raw(p);
+        assert_eq!(view.cast::<windows_core::IUnknown>().unwrap().as_raw(), p);
+        assert_eq!(view.GetDesc().NumDescriptors, 4);
+        let key = super::descriptor_view::native(p as usize);
+        let raw = key as *mut c_void;
+        assert_ne!(raw, p);
+        let native = ID3D12DescriptorHeap::from_raw_borrowed(&raw).unwrap().clone();
+        let start = super::console_heap::start(key).unwrap();
+        for slot in [9, 10] {
+            let f: unsafe extern "system" fn(*mut c_void) -> u64 = std::mem::transmute(*vt(p).add(slot));
+            assert_eq!(f(p), start);
+        }
+        assert_ne!(native.GetCPUDescriptorHandleForHeapStart().ptr as u64, start);
+        list.SetDescriptorHeaps(&super::list_x::pc_heaps(1, &(p as usize)));
+        list.Close().unwrap();
+        drop(list);
+        drop(view);
+        assert_eq!(super::console_heap::start(key), Some(start));
+        drop(native);
+        assert_eq!(super::console_heap::start(key), None);
+    }
+}
