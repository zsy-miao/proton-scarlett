+#[cfg(test)]
+#[test]
+#[ignore = "requires a Wine desktop"]
+fn fallback_clips_only_console_windows() {
+    use windows_sys::Win32::Graphics::Gdi::{GetWindowRgnBox, NULLREGION};
+    use windows_sys::Win32::UI::WindowsAndMessaging::{DestroyWindow, ShowWindow, SW_SHOW};
+    unsafe {
+        let make = |console| {
+            let f = if console { create_window_ex_w } else { CreateWindowExW };
+            f(0, wide("STATIC").as_ptr(), wide("cloak-probe").as_ptr(), WS_POPUP, 0, 0, 320, 200,
+                std::ptr::null_mut(), std::ptr::null_mut(), std::ptr::null_mut(), std::ptr::null_mut())
+        };
+        let console = make(true);
+        let other = make(false);
+        assert!(!console.is_null() && !other.is_null());
+        ShowWindow(console, SW_SHOW);
+        let mut rect = std::mem::zeroed();
+        assert_eq!(GetWindowRgnBox(console, &mut rect), NULLREGION);
+        assert_ne!(GetWindowRgnBox(other, &mut rect), NULLREGION);
+        for (hwnd, expected) in [(console, 1), (other, 0)] {
+            let mut value = u32::MAX;
+            assert_eq!(get_window_attribute(hwnd, 14, (&mut value as *mut u32).cast(), 4), 0);
+            assert_eq!(value, expected);
+            DestroyWindow(hwnd);
+        }
+        assert!(!PROCS.lock().unwrap().iter().any(|e| e.0 == console as usize));
+    }
+}
