index 0000000000000000000000000000000000000000..c1f654029ae83b000ebfe313933dfa9cf8326833
--- /dev/null
+++ b/crates/xcl/src/hle/d3d12x/descriptor_view.rs
@@ -0,0 +1,73 @@
+//! Xbox returns descriptor handles in rax. Keep that ABI on the title view, not on
+//! the native heap, whose vtable vkd3d checks even in its own getters and Release.
+use std::ffi::c_void;
+use std::sync::{OnceLock, atomic::{AtomicU32, Ordering}};
+use windows_core::{GUID, Interface, IUnknown};
+use windows::Win32::Graphics::Direct3D12::*;
+
+#[repr(C)]
+struct View {
+    vt: *const usize,
+    heap: ID3D12DescriptorHeap,
+    refs: AtomicU32,
+}
+static VT: OnceLock<[usize; 11]> = OnceLock::new();
+
+pub(super) unsafe fn wrap(ppv: *mut *mut c_void) {
+    let vt = VT.get_or_init(|| {
+        let mut v = [0; 11];
+        v[..3].copy_from_slice(&[qi as usize, add as usize, release as usize]);
+        for slot in 3..=8 {
+            v[slot] = super::title_list::forward(slot, std::mem::offset_of!(View, heap));
+        }
+        v[9..].copy_from_slice(&[cpu as usize, gpu as usize]);
+        v
+    });
+    let heap = ID3D12DescriptorHeap::from_raw(*ppv);
+    *ppv = Box::into_raw(Box::new(View { vt: vt.as_ptr(), heap, refs: 1.into() })).cast();
+}
+
+pub(super) unsafe fn native(p: usize) -> usize {
+    if p != 0 && VT.get().is_some_and(|v| *(p as *const *const usize) == v.as_ptr()) {
+        (*(p as *const View)).heap.as_raw() as usize
+    } else { p }
+}
+
+unsafe extern "system" fn qi(p: *mut View, iid: *const GUID, out: *mut *mut c_void) -> i32 {
+    if out.is_null() { return 0x80004003u32 as i32; }
+    *out = std::ptr::null_mut();
+    let Some(iid) = iid.as_ref() else { return 0x80004003u32 as i32 };
+    if [IUnknown::IID, ID3D12Object::IID, ID3D12DeviceChild::IID, ID3D12Pageable::IID, ID3D12DescriptorHeap::IID].contains(iid) {
+        add(p);
+        *out = p.cast();
+        0
+    } else { crate::util::E_NOINTERFACE }
+}
+unsafe extern "system" fn add(p: *mut View) -> u32 {
+    (*p).refs.fetch_add(1, Ordering::Relaxed) + 1
+}
+unsafe extern "system" fn release(p: *mut View) -> u32 {
+    let n = (*p).refs.fetch_sub(1, Ordering::AcqRel) - 1;
+    if n == 0 { drop(Box::from_raw(p)); }
+    n
+}
+unsafe extern "system" fn cpu(p: *mut View) -> u64 {
+    let h = &(*p).heap;
+    super::console_heap::start(h.as_raw() as usize).unwrap_or_else(|| h.GetCPUDescriptorHandleForHeapStart().ptr as u64)
+}
+unsafe extern "system" fn gpu(p: *mut View) -> u64 {
+    let h = &(*p).heap;
+    super::console_heap::start(h.as_raw() as usize).unwrap_or_else(|| h.GetGPUDescriptorHandleForHeapStart().ptr)
+}
+
+/// Native references (e.g. a bound heap) may outlive the title's last view.
+#[windows_core::implement()]
+struct Slots { key: usize }
+impl Drop for Slots {
+    fn drop(&mut self) { super::console_heap::unregister(self.key); }
+}
+pub(super) unsafe fn track_slots(heap: &ID3D12DescriptorHeap) -> windows_core::Result<()> {
+    const KEY: GUID = GUID::from_u128(0x28d590a0_2af1_4fa3_a659_39705d6eb2c0);
+    let owner: IUnknown = Slots { key: heap.as_raw() as usize }.into();
+    heap.SetPrivateDataInterface(&KEY, &owner)
+}
