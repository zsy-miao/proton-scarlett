+unsafe fn native_resource_table(resource: &ID3D12Resource) -> windows_core::Result<()> {
+    use windows_sys::Win32::System::LibraryLoader::*;
+    use windows_sys::Win32::System::Memory::*;
+    let table = vt(resource.as_raw());
+    let mut tables = RESOURCE_TABLES.write().unwrap();
+    if tables.iter().any(|(t, _)| *t == table as usize) { return Ok(()); }
+    let first = table.add(8);
+    let bytes = std::mem::size_of::<[usize; 5]>();
+    let mut mbi: MEMORY_BASIC_INFORMATION = std::mem::zeroed();
+    if VirtualQuery(first.cast(), &mut mbi, std::mem::size_of_val(&mbi)) == 0
+        || mbi.Type != MEM_IMAGE || !matches!(mbi.Protect, PAGE_READONLY | PAGE_WRITECOPY | PAGE_READWRITE)
+        || first as usize + bytes > mbi.BaseAddress as usize + mbi.RegionSize {
+        return Err(windows_core::Error::from_hresult(windows_core::HRESULT(crate::util::E_INVALIDARG)));
+    }
+    let saved: [usize; 5] = first.cast::<[usize; 5]>().read();
+    let hooks = [(8usize, res_map as usize), (9, res_unmap as usize), (11, res_gpu_va_x as usize), (12, res_write_to_subresource as usize)]
+        .map(|(slot, hook)| (slot, super::guard::make_split(hook, saved[slot - 8])));
+    // The table and its saved function addresses remain valid for the host process.
+    let mut module = std::ptr::null_mut();
+    if GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN, table.cast(), &mut module) == 0 {
+        return Err(windows_core::Error::from_thread());
+    }
+    tables.reserve(1);
+    let mut old = 0;
+    if VirtualProtect(first.cast(), bytes, PAGE_READWRITE, &mut old) == 0 { return Err(windows_core::Error::from_thread()); }
+    for (slot, hook) in hooks {
+        AtomicUsize::from_ptr(table.add(slot).cast_mut()).store(hook, Ordering::Release);
+    }
+    tables.push((table as usize, saved));
+    let mut ignored = 0;
+    if VirtualProtect(first.cast(), bytes, old, &mut ignored) == 0 {
+        // A published table must never be left writable in the running host.
+        std::process::abort();
+    }
+    Ok(())
