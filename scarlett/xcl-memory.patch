+#[cfg(test)]
+#[test]
+#[ignore = "run alone to measure process memory"]
+fn private_usage_tracks_committed_pages() {
+    unsafe {
+        let n = 32usize << 20;
+        let before = process_private_bytes();
+        let p = mem::VirtualAlloc(std::ptr::null(), n, mem::MEM_COMMIT | mem::MEM_RESERVE, mem::PAGE_READWRITE) as *mut u8;
+        assert!(!p.is_null());
+        for i in (0..n).step_by(4096) { p.add(i).write_volatile(1); }
+        let during = process_private_bytes();
+        assert_ne!(mem::VirtualFree(p.cast(), 0, mem::MEM_RELEASE), 0);
+        let after = process_private_bytes();
+        eprintln!("private usage: before={before}, committed={during}, released={after}");
+        assert!(before > 0 && during >= before + (24 << 20) && during >= after + (24 << 20));
+    }
+}
