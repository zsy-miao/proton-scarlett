+#[cfg(test)]
+#[test]
+#[ignore = "requires a real D3D12 device; run alone to check global UMA accounting"]
+fn native_heap_lifetime() {
+    unsafe {
+        let mut device: Option<ID3D12Device> = None;
+        D3D12CreateDevice(None, D3D_FEATURE_LEVEL_12_0, &mut device).unwrap();
+        let device = device.unwrap();
+        let u = crate::gpu::uma::get().unwrap();
+        for coherent in [true, false] {
+            let before = (u.used(), u.sparse_used());
+            let mut heap: Option<ID3D12Heap> = None;
+            let bytes = 0x10000;
+            let desc = D3D12_HEAP_DESC {
+                SizeInBytes: bytes, Properties: D3D12_HEAP_PROPERTIES { Type: D3D12_HEAP_TYPE_DEFAULT, ..Default::default() },
+                Flags: D3D12_HEAP_FLAG_ALLOW_ONLY_BUFFERS, ..Default::default()
+            };
+            device.CreateHeap(&desc, &mut heap).unwrap();
+            let heap = heap.unwrap();
+            let key = heap.as_raw() as usize;
+            let vtable = vt(heap.as_raw());
+            adopt(heap.as_raw(), Kind::Heap);
+            if on_wine() { assert_eq!(vt(heap.as_raw()), vtable); }
+            assert_eq!(pc_heap_desc(key).unwrap().SizeInBytes, bytes);
+            HeapUma { size: bytes as usize, align: 0x10000, prefer_coherent: coherent, cpu_readback: coherent, block: Mutex::new(None) }
+                .attach(&heap).unwrap();
+            let (addr, _) = heap_block(key).unwrap();
+            assert_eq!(u.is_sparse(addr), !coherent && u.has_sparse());
+            let after = (u.used(), u.sparse_used());
+            assert_eq!(after.0 + after.1 - before.0 - before.1, bytes as usize);
+            let held = heap.clone();
+            drop(heap);
+            assert_eq!(heap_block(key), Some((addr, coherent)));
+            drop(held);
+            assert_eq!(heap_block(key), None);
+            assert_eq!((u.used(), u.sparse_used()), before);
+        }
+    }
+}
