+/* After A8 the two BGRA targets and one float target race for consecutive slots.
+ * Check possible starts separately from the live cross-format range lease below. */
+static bool scarlett_single_offset(DXGI_FORMAT format, SIZE_T off, bool native)
+{
+    const SIZE_T base=0xf000000, first=base+(native?0x880000:0x800000);
+    const SIZE_T bgra=native?0x1010000:0x1000000, full=native?0x1ce0000:0x1e00000;
+    switch(format) {
+        case DXGI_FORMAT_A8_UNORM: return off==base;
+        case DXGI_FORMAT_R16G16B16A16_FLOAT:
+            return (!native && off==base) || off==first || off==first+bgra || off==first+2*bgra;
+        case DXGI_FORMAT_B8G8R8A8_UNORM:
+            return off==first || off==first+bgra || off==first+full || off==first+full+bgra;
+        default: return false;
+    }
+}
