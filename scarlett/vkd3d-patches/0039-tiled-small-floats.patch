+
+HRESULT WINAPI ScarlettTiledRG160V1(d3d12_device_iface *iface,ID3D12Heap *native,HANDLE section,SIZE_T size,SIZE_T off,ID3D12Resource **out)
+{
+    if (!out) return E_POINTER;
+    *out=NULL;
+    if (off!=(native?0x15440000:0x15fd0000)) return E_INVALIDARG;
+    return scarlett_wc_buffer(iface,native,section,size,off,0x1cc00,out);
+}
+
+HRESULT WINAPI ScarlettTiledFloat160V1(d3d12_device_iface *iface,ID3D12Heap *native,HANDLE section,SIZE_T size,SIZE_T off,ID3D12Resource **out)
+{
+    if (!out) return E_POINTER;
+    *out=NULL;
+    if (off!=0xe6c0800) return E_INVALIDARG;
+    return scarlett_wc_buffer(iface,native,section,size,off,0xf000,out);
+}
