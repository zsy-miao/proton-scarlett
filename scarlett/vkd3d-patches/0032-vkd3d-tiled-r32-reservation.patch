+/* Section imports may have different Win32 handles for the same allocation.
+ * Native pool images and buffers instead retain the very same heap identity. */
+static HRESULT scarlett_reserve_wc_slice(struct scarlett_slice *s)
+{
+    BOOL (WINAPI *same)(HANDLE,HANDLE)=NULL;
+    struct scarlett_slice *it;
+    if (s->wc_section && !(same=(void*)GetProcAddress(GetModuleHandleW(L"kernelbase.dll"),"CompareObjectHandles"))) return E_NOTIMPL;
+    pthread_mutex_lock(&scarlett_slice_lock);
+    for (it=scarlett_slices;it;it=it->next)
+        if (s->start<it->end && it->start<s->end && (s->wc_section ? it->wc_section && same(it->wc_section,s->wc_section) : it->lease==s->lease)) break;
+    if (!it){s->next=scarlett_slices;scarlett_slices=s;}
+    pthread_mutex_unlock(&scarlett_slice_lock);
+    return it?DXGI_ERROR_INVALID_CALL:S_OK;
+}
