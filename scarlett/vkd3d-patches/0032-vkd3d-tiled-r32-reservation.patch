             return (!native && off==base) || off==first || off==first+bgra || off==first+2*bgra;
         case DXGI_FORMAT_B8G8R8A8_UNORM:
-            return off==first || off==first+bgra || off==first+full || off==first+full+bgra;
+            /* A later BGRA rounds up to 64KiB after one or two guest-aligned R32 slots. */
+            for (unsigned int n=0;n<=2;n++) {
+                SIZE_T after=first+full+align(n*0x384000u,0x10000);
+                if (off==after || off==after+bgra) return true;
+            }
+            return off==first || off==first+bgra;
         default: return false;
     }
 }
 
+static bool scarlett_r32_offset(SIZE_T off,bool native)
+{
+    const SIZE_T bgra=native?0x1010000:0x1000000;
+    const SIZE_T first=0xf000000+(native?0x880000+0x1ce0000:0x800000+0x1e00000);
+    unsigned int n;
+    /* Earlier RTX float-first trace, without the A8/BGRA allocations. */
+    if (!native && (off==0x10e00000 || off==0x11184000)) return true;
+    for(n=0;n<=2;n++)
+        if(off==first+n*bgra || off==first+n*bgra+0x384000 || (n && off==first+n*bgra+0x390000)) return true;
+    return false;
+}
