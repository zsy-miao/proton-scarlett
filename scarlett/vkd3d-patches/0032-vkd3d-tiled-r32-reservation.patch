+HRESULT WINAPI ScarlettTiledR32BufferV1(d3d12_device_iface *iface,ID3D12Heap *native,HANDLE section,SIZE_T size,SIZE_T off,ID3D12Resource **out)
+{
+    const SIZE_T span=0x384000;
+    const D3D12_RESOURCE_DESC1 rd={D3D12_RESOURCE_DIMENSION_BUFFER,0,span,1,1,1,DXGI_FORMAT_UNKNOWN,{1,0},D3D12_TEXTURE_LAYOUT_ROW_MAJOR,D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS};
+    struct d3d12_device *d;
+    struct d3d12_heap *heap;
+    struct d3d12_resource *r;
+    struct scarlett_slice *s;
+    ID3D12Heap *imported=NULL;
+    HRESULT hr;
+    if(!out)return E_POINTER;
+    *out=NULL;
+    if(!iface || !!native==!!section || size!=0x89700000 || !scarlett_r32_offset(off,!!native))return E_INVALIDARG;
+    d=impl_from_ID3D12Device(iface);
+    if(FAILED(hr=ID3D12Device_GetDeviceRemovedReason((ID3D12Device*)iface)))return hr;
+    if(native){
+        heap=impl_from_ID3D12Heap(native);
+        if(!heap->scarlett_native_pool || heap->device!=d)return E_INVALIDARG;
+    }else{
+        if(d->device_info.properties2.properties.vendorID!=0x10de)return DXGI_ERROR_UNSUPPORTED;
+        if(FAILED(hr=ScarlettWcHeapV1(iface,size,section,NULL,&imported)))return hr;
+        heap=impl_from_ID3D12Heap(imported);
+    }
+    hr=DXGI_ERROR_UNSUPPORTED;
+    if(heap->desc.SizeInBytes!=size || heap->allocation.offset || !heap->allocation.device_allocation.vk_memory ||
+            heap->allocation.device_allocation.size!=size || heap->allocation.device_allocation.vk_memory_type!=(native?2u:3u))goto done;
+    if(!(s=vkd3d_calloc(1,sizeof(*s)))){hr=E_OUTOFMEMORY;goto done;}
+    s->start=off;s->end=off+span;
+    if(native){s->lease=(IUnknown*)native;IUnknown_AddRef(s->lease);}
+    else if(!DuplicateHandle(GetCurrentProcess(),section,GetCurrentProcess(),&s->wc_section,0,FALSE,DUPLICATE_SAME_ACCESS)){
+        hr=HRESULT_FROM_WIN32(GetLastError());vkd3d_free(s);goto done;
+    }
+    if(FAILED(hr=scarlett_reserve_wc_slice(s))){
+        if(s->wc_section)CloseHandle(s->wc_section);
+        if(s->lease)IUnknown_Release(s->lease);
+        vkd3d_free(s);goto done;
+    }
+    hr=d3d12_resource_create_placed(d,&rd,heap,off,D3D12_RESOURCE_STATE_UNORDERED_ACCESS,NULL,0,NULL,&r);
+    if(FAILED(hr)){scarlett_remove_slice(s);goto done;}
+    /* Final internal resource destruction, not last title Release, drops the lease. */
+    r->flags|=SCARLETT_PRIMARY | VKD3D_RESOURCE_RETAINED_GPU_REFERENCE;
+    pthread_mutex_lock(&scarlett_slice_lock);s->resource=r;pthread_mutex_unlock(&scarlett_slice_lock);
+    *out=(ID3D12Resource*)&r->ID3D12Resource_iface;
+done:
+    if(imported)ID3D12Heap_Release(imported);
+    return hr;
+}
