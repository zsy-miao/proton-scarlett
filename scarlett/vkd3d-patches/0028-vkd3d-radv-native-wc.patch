+    if(FAILED(hr=d3d12_heap_create(d,&hd,NULL,NULL,&heap)))return hr;
+    if(heap->allocation.offset || heap->allocation.device_allocation.vk_memory_type!=2 || heap->allocation.device_allocation.size!=hd.SizeInBytes || !heap->allocation.cpu_address) {
