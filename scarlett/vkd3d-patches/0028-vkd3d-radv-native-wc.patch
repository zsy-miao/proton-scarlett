+    query_fn query=(query_fn)(void*)GetProcAddress(GetModuleHandleW(L"ntdll.dll"),"NtQueryVirtualMemory");UINT64 id=0;
+    if(!query || query(GetCurrentProcess(),heap->allocation.cpu_address,0x53430103,&id,sizeof id,NULL) || !id){ID3D12Heap1_Release(&heap->ID3D12Heap_iface);return S_FALSE;}
+    heap->scarlett_native_pool=true;
+    *base=heap->allocation.cpu_address;heap->allocation.cpu_address=NULL;
+    heap->allocation.flags&=~VKD3D_ALLOCATION_FLAG_CPU_ACCESS;
