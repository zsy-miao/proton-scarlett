+        }
         alloc_info.flags |= VKD3D_ALLOCATION_FLAG_DEDICATED | VKD3D_ALLOCATION_FLAG_NO_FALLBACK;
         alloc_info.heap_flags |= control ? SCARLETT_CONTROL_BUFFER : SCARLETT_EXTERNAL_BUFFER;
     }
