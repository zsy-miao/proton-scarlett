+#ifdef _WIN32
+/* Private x64 ABI: the D3DKMT handle retains the allocation independently of this heap. */
+HRESULT WINAPI ScarlettWcHeapV1(d3d12_device_iface *iface, SIZE_T size, HANDLE input, HANDLE *output, ID3D12Heap **result)
+{
+    VkMemoryGetWin32HandleInfoKHR get = {VK_STRUCTURE_TYPE_MEMORY_GET_WIN32_HANDLE_INFO_KHR};
+    VkImportMemoryWin32HandleInfoKHR imp = {VK_STRUCTURE_TYPE_IMPORT_MEMORY_WIN32_HANDLE_INFO_KHR};
+    VkExportMemoryAllocateInfo exp = {VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO};
+    struct d3d12_device *device = impl_from_ID3D12Device(iface);
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+    const VkPhysicalDeviceProperties *p = &device->device_info.properties2.properties;
+    struct d3d12_heap *heap;
+    D3D12_HEAP_DESC desc = {0};
+    HRESULT hr;
+
+    if (!result || (!input && !output)) return E_INVALIDARG;
+    *result = NULL;
+    if (output) *output = NULL;
+    if (!size || size % 65536) return E_INVALIDARG;
+    /* Only this device/driver/type has measured WC rather than merely non-HOST_CACHED. */
+    if (p->vendorID != 0x10de || p->deviceID != 0x2484 || p->driverVersion != ((595u<<22)|(112u<<14)|(7u<<6)) ||
+            device->device_info.vulkan_1_2_properties.driverID != VK_DRIVER_ID_NVIDIA_PROPRIETARY ||
+            device->memory_properties.memoryTypeCount <= 3 || device->memory_properties.memoryTypes[3].propertyFlags !=
+            (VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT) ||
+            !vk_procs->vkGetMemoryWin32HandleKHR) return DXGI_ERROR_UNSUPPORTED;
+    desc.SizeInBytes = size;
+    desc.Properties.CreationNodeMask = desc.Properties.VisibleNodeMask = 1;
+    desc.Properties.Type = D3D12_HEAP_TYPE_CUSTOM;
+    desc.Properties.CPUPageProperty = D3D12_CPU_PAGE_PROPERTY_WRITE_COMBINE;
+    desc.Properties.MemoryPoolPreference = D3D12_MEMORY_POOL_L0;
+    desc.Flags = D3D12_HEAP_FLAG_ALLOW_ONLY_BUFFERS;
+    imp.handleType = SCARLETT_DMA_HANDLE;
+    imp.handle = input;
+    exp.handleTypes = SCARLETT_DMA_HANDLE;
+    if (FAILED(hr = d3d12_heap_create(device, &desc, NULL, input ? (void *)&imp : (void *)&exp, &heap))) return hr;
+    if (heap->allocation.offset || heap->allocation.device_allocation.vk_memory_type != 3) hr = E_FAIL;
+    if (SUCCEEDED(hr) && !input)
+    {
+        get.memory = heap->allocation.device_allocation.vk_memory;
+        get.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT;
+        if (VK_CALL(vkGetMemoryWin32HandleKHR(device->vk_device, &get, output)) || !*output) hr = E_FAIL;
+    }
+    if (FAILED(hr)) ID3D12Heap1_Release(&heap->ID3D12Heap_iface);
+    else *result = (ID3D12Heap *)&heap->ID3D12Heap_iface;
+    return hr;
+}
+#endif
