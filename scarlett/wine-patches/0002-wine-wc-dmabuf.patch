+    {
+        req->type = D3DKMT_RESOURCE;
+        req->handle = wine_server_obj_handle( ref );
+        wine_server_set_reply( req, wc_tag, sizeof(wc_tag) );
+        if (!(status = wine_server_call( req ))) obj = wine_server_ptr_handle( reply->handle );
+    }
+    SERVER_END_REQ;
+    if (!status && (wc_tag[0] != 0x5343574300000001ull || wc_tag[1] != size)) status = STATUS_INVALID_PARAMETER;
