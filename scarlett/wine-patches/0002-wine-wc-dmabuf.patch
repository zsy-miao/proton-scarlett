+        (UINT_PTR)addr > (UINT_PTR)user_space_limit - size) return STATUS_INVALID_PARAMETER;
+    if ((status = NtDuplicateObject( NtCurrentProcess(), shared, NtCurrentProcess(), &ref, 0, 0,
