  *
  * Free a window handle.
  */
+/* Private native-x64 display provider. Match creation provenance; never pick
+ * a foreground window, a process-global HWND value, or a window by dimensions. */
+struct scarlett_window {
+    struct scarlett_window *next;
+    HWND hwnd;
+    DWORD tid;
+    ULONG_PTR generation;
+};
+static struct scarlett_window *scarlett_windows;
+static ULONG_PTR scarlett_generation;
+static BOOL scarlett_unavailable;
+
+static BOOL scarlett_image(void)
+{
+    static const WCHAR exe[] = {'g','a','m','e','_','s','c','a','r','l','e','t','t','_','m','a','s','t','e','r','.','e','x','e',0};
+    const UNICODE_STRING *path = &NtCurrentTeb()->Peb->ProcessParameters->ImagePathName;
+    size_t len = path->Length / sizeof(WCHAR), n = ARRAY_SIZE(exe)-1;
+    return len >= n && (len == n || path->Buffer[len-n-1] == '\\' || path->Buffer[len-n-1] == '/') &&
+           !wcsnicmp( path->Buffer+len-n, exe, n );
+}
+
+static void scarlett_register( HWND hwnd )
+{
+    struct scarlett_window *s;
+    WND *win = get_win_ptr( hwnd );
+    if (!win || win == WND_OTHER_PROCESS || win == WND_DESKTOP) return;
+    s = malloc( sizeof(*s) );
+    if (!s || !++scarlett_generation) { free(s); scarlett_unavailable = TRUE; }
+    else {
+        s->hwnd = win->handle;
+        s->tid = GetCurrentThreadId();
+        s->generation = scarlett_generation;
+        s->next = scarlett_windows;
+        scarlett_windows = s;
+    }
+    release_win_ptr( win );
+}
+
+/* Caller holds user_lock. Also used when a thread exits without DestroyWindow. */
+static void scarlett_forget( HWND hwnd )
+{
+    struct scarlett_window **p, *s;
+    for (p = &scarlett_windows; (s = *p); p = &s->next)
+        if (s->hwnd == hwnd) { *p = s->next; free(s); break; }
+}
+
+static ULONG_PTR scarlett_query( HWND hwnd, ULONG_PTR param, DWORD code )
+{
+    ULONG_PTR result = 0;
+    struct scarlett_window *s;
+    user_lock();
+    if (!scarlett_unavailable && (s = scarlett_windows) && !s->next && s->tid == GetCurrentThreadId())
+    {
+        if (code == 0x53435701 && !hwnd && param == GetCurrentProcessId()) result = s->generation;
+        if (code == 0x53435702 && (!hwnd || hwnd == s->hwnd) && param == s->generation)
+            result = (ULONG_PTR)s->hwnd;
+    }
+    user_unlock();
+    return result;
+}
