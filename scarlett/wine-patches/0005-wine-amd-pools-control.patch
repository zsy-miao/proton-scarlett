+static int control_gem_fd( struct vulkan_device *device, int source )
+{
+#if defined(__linux__) && defined(HAVE_AMDGPU_DRM_H)
+    struct vulkan_physical_device *phys = device->physical_device;
+    /* Host-only VkPhysicalDeviceDrmPropertiesEXT is omitted from Wine's generated PE header. */
+    struct { VkStructureType sType; void *pNext; VkBool32 hasPrimary, hasRender;
+             int64_t primaryMajor, primaryMinor, renderMajor, renderMinor; } drm = {.sType = 1000353000};
+    VkPhysicalDeviceProperties2 props = {.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, .pNext = &drm};
+    const unsigned int required = AMDGPU_GEM_CREATE_CPU_GTT_USWC | AMDGPU_GEM_CREATE_UNCACHED;
+    union drm_amdgpu_gem_create create = {.in = {.domains = AMDGPU_GEM_DOMAIN_GTT, .bo_size = 65536,
+        .alignment = 65536, .domain_flags = required | AMDGPU_GEM_CREATE_CPU_ACCESS_REQUIRED}};
+    struct drm_prime_handle prime = {.fd = source, .flags = source < 0 ? DRM_CLOEXEC | DRM_RDWR : 0};
+    struct drm_amdgpu_gem_create_in actual = {0};
+    struct drm_amdgpu_gem_op op = {.op = AMDGPU_GEM_OP_GET_GEM_CREATE_INFO, .value = (uintptr_t)&actual};
+    struct stat st;
+    char path[64];
+    int fd, ret = -1;
+
+    if (!device->extensions.has_VK_EXT_external_memory_dma_buf || !phys->instance->p_vkGetPhysicalDeviceProperties2)
+        return -1;
+    phys->instance->p_vkGetPhysicalDeviceProperties2( phys->host.physical_device, &props );
+    if (!drm.hasRender || props.properties.vendorID != 0x1002 || props.properties.deviceID != 0x164e)
+        return -1;
+    snprintf( path, sizeof(path), "/dev/dri/renderD%u", (unsigned int)drm.renderMinor );
+    if ((fd = open( path, O_RDWR | O_CLOEXEC )) < 0) return -1;
+    if (fstat( fd, &st ) || !S_ISCHR(st.st_mode) || st.st_rdev != makedev(drm.renderMajor,drm.renderMinor)) goto done;
+    if (source < 0)
+    {
+        if (ioctl( fd, DRM_IOCTL_AMDGPU_GEM_CREATE, &create )) goto done;
+        prime.handle = create.out.handle;
+    }
+    else if (ioctl( fd, DRM_IOCTL_PRIME_FD_TO_HANDLE, &prime )) goto done;
+    op.handle = prime.handle;
+    if (ioctl( fd, DRM_IOCTL_AMDGPU_GEM_OP, &op ) || actual.bo_size != 65536 ||
+        actual.domains != AMDGPU_GEM_DOMAIN_GTT || (actual.domain_flags & required) != required) goto done;
+    if (source < 0 && ioctl( fd, DRM_IOCTL_PRIME_HANDLE_TO_FD, &prime )) goto done;
+    ret = prime.fd;
+done:
+    close( fd );
+    return ret;
+#else
+    return -1;
+#endif
