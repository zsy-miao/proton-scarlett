+static BOOL scarlett_server( HWND hwnd, int op, ULONG_PTR generation )
+{
+    BOOL ok;
+    SERVER_START_REQ( set_window_info )
+    {
+        req->handle = wine_server_user_handle( hwnd );
+        req->offset = -0x534300 - op;
+        req->new_info = generation;
+        ok = !wine_server_call( req ) && reply->old_info == generation;
+    }
+    SERVER_END_REQ;
+    return ok;
+}
