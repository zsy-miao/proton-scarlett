+/* Under descriptor_lock. The importer pins a 64 MiB arena and admits only
+ * offsets 0 and one aligned physical allocation size. No VA-only stand-ins. */
+static struct color_resource *sibling_pair(struct xbox_device *d,ID3D12CommandQueue *q)
+{
+    struct color_resource *a=NULL,*b=NULL;
+    for(struct color_resource *r=d->colors;r;r=r->next)if(r->slice){
+        if(&r->iface==d->aba.a.identity)a=r;
+        else if(&r->iface==d->aba.b.identity)b=r;
+        else return NULL;
+    }
+    if(!a || !b || a->owner!=d || b->owner!=d || a->host==b->host ||
+       a->host!=d->aba.a.host || b->host!=d->aba.b.host || a->msaa || b->msaa ||
+       !a->import_base || a->import_base!=b->import_base || !a->import_bytes ||
+       a->import_bytes!=b->import_bytes || a->import_bytes>(32u<<20) ||
+       a->writer!=q || b->writer!=q || !a->claimed || !b->claimed || a->flipping || b->flipping ||
+       a->multi_writer || b->multi_writer || a->writer_epoch!=1 || b->writer_epoch!=d->aba.bw ||
+       a->common_serial!=14 || d->aba.a.slot!=a->common_slot || d->aba.a.slot==d->aba.b.slot)return NULL;
+    UINT_PTR ao=(UINT_PTR)a->slice-(UINT_PTR)a->import_base,bo=(UINT_PTR)b->slice-(UINT_PTR)b->import_base;
+    if(!((ao==0 && bo==a->import_bytes) || (bo==0 && ao==a->import_bytes)))return NULL;
+    D3D12_CPU_DESCRIPTOR_HANDLE at;
+    return sr_descriptor(d,&d->aba.a,&at,FALSE) && sr_descriptor(d,&d->aba.b,&at,FALSE)?a:NULL;
+}
+static void sibling_claim(struct xbox_device *d,struct color_resource *b,SIZE_T slot,UINT64 serial,ID3D12CommandQueue *q)
+{
+    memset(&d->aba,0,sizeof d->aba);
+    if(serial!=17 || !b->import_bytes || !b->claimed || !b->writer_epoch)return;
+    for(struct color_resource *a=d->colors;a;a=a->next)if(a!=b && a->common_epoch==1 && a->common_serial==14){
+        d->aba.a=(struct xs_attachment_pin){&a->iface,a->host,a->common_slot,14};
+        d->aba.b=(struct xs_attachment_pin){&b->iface,b->host,slot,17};
+        d->aba.bw=b->writer_epoch;
+        if(!sibling_pair(d,q))memset(&d->aba,0,sizeof d->aba);
+        break;
+    }
+}
+/* Called only for token 2's successful 1->0 return, while the flip pin is held. */
+void xs_s14_presented(IUnknown *pin,ID3D12Fence *end)
+{
+    struct color_resource *b=CONTAINING_RECORD(pin,struct color_resource,iface);
+    struct xbox_device *d=b->owner;
+    AcquireSRWLockExclusive(&d->descriptor_lock);
+    if(b->flipping && d->aba.b.identity==pin)d->aba.end=end;
+    ReleaseSRWLockExclusive(&d->descriptor_lock);
+}
