+/* The recorder has already identified the producer, or emitted the successor
+ * barrier/timestamp. Seal immutable native recordings, never the submitted face. */
+static void seal14(struct startup_list *s,IUnknown *id)
+{
+    BOOL producer=!s->s14_head;
+    if(s->seal || s->deferred || s->offered || s->host_exposed || !s->closed || s->error!=S_OK ||
+       !s->reservation || !s->allocator || s->allocator->lpVtbl!=&at.prefix || !s->stamp ||
+       !s->trace_pub.record || s->trace_pub.list!=(UINT_PTR)id || s->s14_tid!=GetCurrentThreadId())return;
+    if(producer && (!s->sr.end || !s->sr.rt.identity || !s->sr.ds.identity || s->output_serial!=14 ||
+       s->reuse_epoch!=1 || !s->head || s->head==s->host || !s->tail_allocator || !s->marker ||
+       !s->post || s->post->parent!=s->marker || !s->marker->alias || !s->post->counter ||
+       s->post->counter!=s->marker->alias || s->post->threshold!=1))return;
+    if(!producer && (!s14_successor(s) || s->stamp==s->s14_head))return;
+    struct pair_gen *g=HeapAlloc(GetProcessHeap(),HEAP_ZERO_MEMORY,sizeof *g);
+    if(!g)return;
+    if(producer){
+        struct xs_clear_source *in[]={&s->source,&s->previous_vb,&s->vb};
+        for(UINT k=0;k<3;k++){
+            const struct lease_span *v=&in[k]->span;
+            if(!in[k]->needs_publication || !in[k]->buffer || !in[k]->placed || !in[k]->capture ||
+               in[k]->capture!=in[0]->capture || in[k]->placed!=in[0]->placed ||
+               v->node!=s->trace_pub.node || v->gen!=s->trace_pub.gen || v->data!=in[0]->span.data ||
+               memcmp(&v->arena,&in[0]->span.arena,sizeof v->arena) || v->va-v->data!=((UINT[]){0x1ff80,0x1ef30,0x1df10})[k] ||
+               v->bytes!=(k?4080u:100u) || v->holds!=(k?3u:2u) || v->stamp!=~1ull)goto bad;
+            g->spans[k]=*v;
+        }
+        if(in[0]->buffer==in[1]->buffer || in[1]->buffer==in[2]->buffer || in[2]->buffer==in[0]->buffer)goto bad;
+        if(!(g->writer=xs_s14_clock(s->pool_owner,s->sr.end,&g->frame_epoch)))goto bad;
+    }
+    g->allocator=CONTAINING_RECORD(s->allocator,struct command_allocator,a.iface);
+    AcquireSRWLockExclusive(&g->allocator->lock);
+    if(g->allocator->generation!=(LONG64)s->alloc_generation ||
+       g->allocator->submission_pins==UINT_MAX || (UINT_PTR)g->allocator->entry!=(UINT_PTR)GetModuleHandleW(NULL)+0x555df10 ||
+       !pub_close((UINT_PTR)g->allocator->context,(UINT_PTR)id,producer,s->trace_pub.node,s->trace_pub.gen,&g->publication) ||
+       g->publication.record!=s->trace_pub.record || g->publication.arg!=s->trace_pub.arg || g->publication.pool!=s->trace_pub.pool){
+        ReleaseSRWLockExclusive(&g->allocator->lock);goto bad;
+    }
+    ++g->allocator->submission_pins;ReleaseSRWLockExclusive(&g->allocator->lock);
+    g->segments=(struct startup_list){.device=s->device,.head=s->head,.host=s->host,
+        .marker=s->marker,.post=s->post,.pool_owner=s->pool_owner,.primary=s->primary,
+        .primary_pin=s->primary_pin,.output_slot=s->output_slot,.s14_slot=s->s14_slot,
+        .s14_head=s->s14_head,.alloc_generation=s->alloc_generation,.reuse_epoch=s->reuse_epoch,.sr=s->sr};
+    g->stamp=s->stamp;InterlockedIncrement(&g->stamp->refs);
+    if(s->s14_head)InterlockedIncrement(&s->s14_head->refs);
+    if(s->marker)InterlockedIncrement(&s->marker->refs);
+    if(s->post)InterlockedIncrement(&s->post->refs);
+    void *pins[]={s->pool_owner,s->allocator,s->head,s->host,s->tail_allocator,s->heaps[0],s->heaps[1],
+        s->primary,s->primary_pin,s->output_heap,s->om.heap[0],s->om.heap[1],s->first_om.heap[0],s->first_om.heap[1],
+        s->attachments[0].identity,s->attachments[1].identity,s->prior_pso,s->prior_root,s->graphics_identity,s->bound,
+        s->source.placed,s->source.buffer,s->previous_vb.placed,s->previous_vb.buffer,s->vb.placed,s->vb.buffer,
+        s->sr_view,s->sr.end,s->sr.rt.identity,s->sr.ds.identity,g->writer};
+    _Static_assert(ARRAYSIZE(pins)<=ARRAYSIZE(g->pins),"S14 recording pins");
+    for(UINT j=0;j<ARRAYSIZE(pins);j++)pair_pin(g,pins[j]);
+    if(g->writer)ID3D12CommandQueue_Release(g->writer);
+    g->id=id;g->refs=1;g->s14=TRUE;g->producer=producer;
+    AcquireSRWLockExclusive(&pair_lock);g->next=pair_registry;pair_registry=s->seal=g;ReleaseSRWLockExclusive(&pair_lock);
+    return;
+bad:
+    if(g->writer)ID3D12CommandQueue_Release(g->writer);
+    HeapFree(GetProcessHeap(),0,g);
+}
+
+static HRESULT execute14(void *ctx)
+{
+    struct pair_job *w=ctx;struct adapter *a=w->queue;
+    struct pair_gen *g=w->g[0],*h=w->g[1];struct startup_list *p=&g->segments;
+    if(!TryAcquireSRWLockExclusive(&escape_lock))return E_ACCESSDENIED;
+    AcquireSRWLockExclusive(&publisher_lock);
+    struct monitored_fence *f=bridge_escaped?NULL:pair_book(w);
+    HRESULT hr=E_ACCESSDENIED;
+    if(f && ID3D12Fence_GetCompletedValue(p->sr.end)==1 &&
+       xs_live_output(p->pool_owner,p->primary_pin,p->primary,p->output_slot,14))
+        hr=xs_reuse_with_sr(p->pool_owner,p->primary_pin,p->primary,g->writer,&p->reuse_epoch,&p->sr);
+    if(hr==S_OK){
+        f->protected_pair=TRUE;w->book_fence=f;IUnknown_AddRef(&f->a.iface);InterlockedIncrement(&pair_inflight);
+    }
+    ReleaseSRWLockExclusive(&publisher_lock);ReleaseSRWLockExclusive(&escape_lock);
+    if(hr!=S_OK)return hr;
+    g->used=h->used=TRUE;InterlockedIncrement(&g->refs);InterlockedIncrement(&h->refs);IUnknown_AddRef(&a->iface);
+    execute_segments(g->writer,p,&w->prefix,&w->post);
+    ID3D12CommandList *successor=(ID3D12CommandList*)h->segments.host;
+    ID3D12CommandQueue_ExecuteCommandLists(g->writer,1,&successor);
+    if(FAILED(ID3D12CommandQueue_Signal(g->writer,w->end,1)))xs_stop();
+    forget_release(a);
+    if(a->display.captured.hwnd){
+        a->display.released=p->primary;ID3D12Resource_AddRef(p->primary);
+        a->display.released_end=w->end;ID3D12Fence_AddRef(w->end);
+        a->display.released_token=3;a->display.clear_slot=p->output_slot;a->display.clear_serial=14;
+    }
+    fprintf(stderr,"S14 job executed ids=%p/%p ordered=%p/%p/%p oldEnd=%p newEnd=%p publisher=%p prior=4 target=5\n",
+        g->id,h->id,p->head,p->host,successor,p->sr.end,w->end,f);
+    return S_OK;
+}
+static HRESULT submit14(IUnknown *iface,IUnknown *const *lists)
+{
+    IUnknown *ids[2];
+    if(!as_queue(iface) || !pub_read((UINT_PTR)lists,ids,sizeof ids) || !ids[0] || !ids[1] || ids[0]==ids[1])return E_INVALIDARG;
+    struct adapter *a=CONTAINING_RECORD(iface,struct adapter,iface);
+    struct pair_job *w=HeapAlloc(GetProcessHeap(),HEAP_ZERO_MEMORY,sizeof *w);
+    if(!w)return E_OUTOFMEMORY;
+    HRESULT hr=E_ACCESSDENIED;PTP_WAIT waiter=NULL;
+    w->queue=a;w->lists=(UINT_PTR)lists;
+    AcquireSRWLockExclusive(&a->submit_lock);AcquireSRWLockExclusive(&pair_lock);
+    for(struct pair_gen *it=pair_registry;it;it=it->next)if(it->s14)
+        for(UINT k=0;k<2;k++)if(it->id==ids[k])w->g[k]=it;
+    struct pair_gen *g=w->g[0],*h=w->g[1];
+    if(!g || !h || !g->producer || h->producer || g->used || h->used ||
+       a->external_submissions || g->writer!=a->host.queue || g->allocator!=h->allocator ||
+       g->segments.pool_owner!=a->display.owner || h->segments.pool_owner!=a->display.owner ||
+       g->segments.device!=h->segments.device || g->segments.primary_pin!=h->segments.primary_pin ||
+       g->segments.primary!=h->segments.primary || g->segments.output_slot!=h->segments.s14_slot ||
+       h->segments.s14_head!=g->stamp || g->allocator_unpinned || h->allocator_unpinned)goto out;
+    AcquireSRWLockShared(&g->allocator->lock);
+    BOOL pinned=g->allocator->submission_pins>=2 && (UINT64)g->allocator->generation==g->segments.alloc_generation &&
+        g->segments.alloc_generation==h->segments.alloc_generation;
+    ReleaseSRWLockShared(&g->allocator->lock);
+    if(!pinned)goto out;
+    hr=ID3D12Device_CreateFence(g->segments.device,0,0,&IID_ID3D12Fence,(void**)&w->end);
+    if(FAILED(hr))goto out;
+    if(!(w->event=CreateEventW(NULL,FALSE,FALSE,NULL)) || !(waiter=CreateThreadpoolWait(retire_pair,w,NULL))){
+        hr=HRESULT_FROM_WIN32(GetLastError());goto out;
+    }
+    hr=xs_pair_frame_submit(g->segments.pool_owner,3,g->writer,TRUE,w->end,execute14,w,&g->frame_epoch);
+    if(hr==S_OK){
+        if(FAILED(ID3D12Fence_SetEventOnCompletion(w->end,1,w->event)))xs_stop();
+        SetThreadpoolWait(waiter,w->event,NULL);
+    }
+out:
+    ReleaseSRWLockExclusive(&pair_lock);ReleaseSRWLockExclusive(&a->submit_lock);
+    if(hr!=S_OK){if(waiter)CloseThreadpoolWait(waiter);pair_cleanup(w);}
+    return hr;
+}
