--- /dev/null
+++ b/scarlett/native/queue/test-s14-ledger.c
@@ -0,0 +1,51 @@
+/* Observe only the lists recorded by this executable. */
+#define bank3_head record_bank3_head
+#include "test-s14-bank3.c"
+#undef bank3_head
+
+static ID3D12CommandList *head14;
+static IUnknown *writer,*prior;
+ID3D12CommandQueue *bank3_writer(ID3D12Device *dev,ID3D12Fence **f)
+{
+    OK(xs_direct_queue(dev,&writer));OK(xs_shared_fence(dev,&prior));
+    *f=as_fence(prior);
+    return as_queue(writer);
+}
+
+void bank3_signal(UINT64 value)
+{
+    OK(queue_signal(writer,prior,value));
+}
+
+BOOL bank3_prior(ID3D12CommandQueue *q,UINT64 high)
+{
+    struct monitored_fence *m=CONTAINING_RECORD(prior,struct monitored_fence,a.iface);
+    return m->publisher==q && !m->mixed && m->high==high;
+}
+
+void bank3_release_writer(void)
+{
+    IUnknown_Release(prior);IUnknown_Release(writer);
+}
+
+void bank3_head(ID3D12Device *dev,ID3D12GraphicsCommandList7 *host)
+{
+    record_bank3_head(dev,host);
+    head14=(ID3D12CommandList*)host;
+}
+
+BOOL bank3_split(UINT n,ID3D12CommandList **ls)
+{
+    struct startup_list *s=sl(list14);
+    return s->closed && s->s14_head && s->stamp && s->s14_head!=s->stamp &&
+        n==2 && ls[0]==head14 && ls[1]==(ID3D12CommandList*)s->host;
+}
+
+void bank3_reset(ID3D12Device *dev)
+{
+    IUnknown *fresh;
+    OK(xs_allocator(dev,0,&fresh));
+    OK(sl_reset(list14,fresh,NULL,0));
+    CK(!sl(list14)->s14_head && !sl(list14)->stamp);
+    IUnknown_Release(fresh);
+}
