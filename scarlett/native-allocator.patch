+//! The title can use allocator extensions. vkd3d's list Create/Reset accepts only its own allocator.
+use std::ffi::c_void;
+use std::sync::{OnceLock, atomic::{AtomicU32, Ordering}};
+use windows_core::{GUID, Interface, IUnknown};
+use windows::Win32::Graphics::Direct3D12::*;
+
+#[repr(C)]
+struct View {
+    table: *const usize,
+    pc: ID3D12CommandAllocator,
+    refs: AtomicU32,
+}
+static TABLE: OnceLock<[usize; 9 + 64]> = OnceLock::new();
+
+pub(super) unsafe fn wrap(pc: ID3D12CommandAllocator) -> *mut c_void {
+    let table = TABLE.get_or_init(|| std::array::from_fn(|i| match i {
+        0 => qi as usize, 1 => add as usize, 2 => release as usize,
+        3..=7 => super::title_list::forward(i, std::mem::offset_of!(View, pc)),
+        8 => reset as usize,
+        _ => crate::stubs::make_stub_info("d3d12_xs.dll", &format!("ID3D12CommandAllocator::#{i} (not on PC)"), 0).0,
+    }));
+    Box::into_raw(Box::new(View { table: table.as_ptr(), pc, refs: 1.into() })).cast()
+}
+
+pub(super) unsafe fn native(p: usize) -> usize {
+    if TABLE.get().is_some_and(|t| crate::gpu::shader::readable(p, 8) && *(p as *const *const usize) == t.as_ptr()) {
+        (*(p as *const View)).pc.as_raw() as usize
+    } else { p }
+}
+
+unsafe extern "system" fn qi(p: *mut View, iid: *const GUID, out: *mut *mut c_void) -> i32 {
+    if out.is_null() { return 0x80004003u32 as i32; }
+    *out = std::ptr::null_mut();
+    let Some(iid) = iid.as_ref() else { return 0x80004003u32 as i32 };
+    if [IUnknown::IID, ID3D12Object::IID, ID3D12DeviceChild::IID, ID3D12Pageable::IID, ID3D12CommandAllocator::IID].contains(iid) {
+        add(p);
+        *out = p.cast();
+        0
+    } else { crate::util::E_NOINTERFACE }
+}
+unsafe extern "system" fn add(p: *mut View) -> u32 {
+    (*p).refs.fetch_add(1, Ordering::Relaxed) + 1
+}
+unsafe extern "system" fn release(p: *mut View) -> u32 {
+    let n = (*p).refs.fetch_sub(1, Ordering::AcqRel) - 1;
+    if n == 0 { drop(Box::from_raw(p)); }
+    n
+}
+unsafe extern "system" fn reset(p: *mut View) -> i32 {
+    let pc = &(*p).pc;
+    match pc.Reset() {
+        Ok(()) => { super::console_list::allocator_reset(pc.as_raw()); 0 }
+        Err(e) => e.code().0,
+    }
+}
+
+pub(super) unsafe extern "system" fn destroyed(p: *mut c_void) {
+    super::list_x::on_allocator_release(p as usize);
+    super::console_list::allocator_reset(p);
+}
