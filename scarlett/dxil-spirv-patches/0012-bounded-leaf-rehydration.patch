+// The compact stream has byte fields and 4-aligned (not 8-aligned) qwords.
+static bool emit_leaf_stream(Converter::Impl &impl, const llvm::CallInst &call, bool byte)
+{
+    auto con = [&](unsigned i, unsigned n) {
+        auto *c = llvm::dyn_cast<llvm::ConstantInt>(call.getOperand(i));
+        return c && c->getUniqueInteger().getZExtValue() == n;
+    };
+    auto u32 = [](const llvm::Type *t) { return t->isIntegerTy() && t->getIntegerBitWidth() == 32; };
+    auto *ret = llvm::dyn_cast<llvm::StructType>(call.getType());
+    if (!ret || ret->getNumElements()!=5 || !u32(call.getOperand(2)->getType()) ||
+        call.getNumOperands() != (byte ? 4u : 6u) || !con(0, byte ? 138 : 139) ||
+        (byte ? !con(3, 65) : (!llvm::isa<llvm::UndefValue>(call.getOperand(3)) || !con(4, 1) || !con(5, 4))) ||
+        impl.llvm_composite_meta[&call].access_mask != 1) return false;
+    for (unsigned i=0;i<5;i++) {
+        auto *elem=ret->getElementType(i);
+        if (!elem->isIntegerTy() || elem->getIntegerBitWidth() != (byte || i==4 ? 32u : 64u)) return false;
+    }
+    auto id = impl.get_id_for_value(call.getOperand(1));
+    const auto &meta = impl.handle_to_resource_meta[id];
+    if (meta.storage != spv::StorageClassStorageBuffer || meta.kind != DXIL::ResourceKind::RawBuffer ||
+        meta.component_type != DXIL::ComponentType::U32 || meta.aliased || meta.raw_component_vecsize != RawVecSize::V1) return false;
+    auto &b = impl.builder(); auto t = b.makeUintType(32);
+    auto op = [&](spv::Op ins, spv::Id type, std::initializer_list<spv::Id> ids) {
+        auto *o = impl.allocate(ins, type); for (auto v : ids) o->add_id(v); impl.add(o); return o->id;
+    };
+    auto addr = impl.get_id_for_value(call.getOperand(2));
+    auto word = op(spv::OpShiftRightLogical, t, {addr, b.makeUintConstant(2)});
+    auto load = [&](spv::Id idx) {
+        // Non-aliased offset buffers carry element offset and element count.
+        if (meta.index_offset_id) {
+            auto elem = [&](unsigned i) { auto *o = impl.allocate(spv::OpCompositeExtract,t);
+                o->add_id(meta.index_offset_id); o->add_literal(i); impl.add(o); return o->id; };
+            auto ok = op(spv::OpULessThan,b.makeBoolType(),{idx,elem(1)});
+            idx = op(spv::OpSelect,t,{ok,op(spv::OpIAdd,t,{idx,elem(0)}),b.makeUintConstant(0x3ffffffc)});
+        }
+        auto ptr = op(spv::OpAccessChain,b.makePointer(meta.storage,t),{id,b.makeUintConstant(0),idx});
+        return op(spv::OpLoad,t,{ptr});
+    };
+    auto lo = load(word); spv::Id result;
+    if (byte) {
+        auto shift = op(spv::OpBitwiseAnd,t,{op(spv::OpShiftLeftLogical,t,{addr,b.makeUintConstant(3)}),b.makeUintConstant(24)});
+        result = op(spv::OpBitwiseAnd,t,{op(spv::OpShiftRightLogical,t,{lo,shift}),b.makeUintConstant(255)});
+    } else {
+        auto hi = load(op(spv::OpIAdd,t,{word,b.makeUintConstant(1)}));
+        result = op(spv::OpBitcast,b.makeUintType(64),{op(spv::OpCompositeConstruct,b.makeVectorType(t,2),{lo,hi})});
+    }
+    impl.llvm_composite_meta[&call].forced_composite = false;
+    impl.rewrite_value(&call,result); return true;
+}
