+static unsigned xbox_memory_opcode(llvm::Function *fn)
+{
+	if (fn->begin() != fn->end()) return 0;
+	if (fn->getName() == "xbox.global_load_dword_with_cache") return 356;
+	if (fn->getName() == "xbox.global_load_dwordx3_with_cache") return 358;
+	if (fn->getName() == "xbox.global_load_dwordx4_with_cache") return 359;
+	if (fn->getName() == "xbox.global_store_dword_with_cache") return 360;
+	if (fn->getName() == "xbox.global_store_dwordx4_with_cache") return 363;
+	return 0;
+}
