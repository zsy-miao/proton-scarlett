+static bool emit_xbox_access(Converter::Impl &impl, const llvm::CallInst &call, unsigned opnum)
+{
+	const bool read = opnum < 360;
+	const unsigned n = opnum - (read ? 356 : 360) + 1;
+	auto integer = [](const llvm::Type *t, unsigned w) { return t->isIntegerTy() && t->getIntegerBitWidth() == w; };
+	if (!impl.options.physical_storage_buffer || impl.execution_model != spv::ExecutionModelGLCompute ||
+	    !impl.root_constant_id || impl.xbox_range_descriptor >= impl.root_descriptor_count ||
+	    impl.root_constant_num_words < 3 || impl.xbox_range_word > impl.root_constant_num_words - 3 ||
+	    read != impl.xbox_read_only || call.getNumOperands() != (read ? 4u : 5u) ||
+	    (!read && call.getType()->getTypeID() != llvm::Type::TypeID::VoidTyID))
+		return false;
+	auto *opcode = llvm::dyn_cast<llvm::ConstantInt>(call.getOperand(0));
+	if (!opcode || !integer(opcode->getType(), 32) || opcode->getUniqueInteger().getZExtValue() != opnum ||
+	    !integer(call.getOperand(1)->getType(), 64)) return false;
+	for (unsigned i = read ? 2 : 3; i < call.getNumOperands(); i++)
+		if (!llvm::isa<llvm::UndefValue>(call.getOperand(i)) || !integer(call.getOperand(i)->getType(), 32)) return false;
+	auto *payload = read ? call.getType() : call.getOperand(2)->getType();
+	if (n == 1 && !integer(payload, 32)) return false;
+	if (n > 1)
+	{
+		auto *s = llvm::dyn_cast<llvm::StructType>(payload);
+		if (!s || s->getNumElements() != n) return false;
+		for (unsigned i = 0; i < n; i++) if (!integer(s->getElementType(i), 32)) return false;
+	}
+	auto &b = impl.builder();
+	auto &helper = impl.xbox_helpers[n - 1];
+	auto payload_id = impl.get_type_id(payload);
+	if (read && n > 1) impl.llvm_composite_meta[&call].forced_composite = true;
+	if (!helper)
+	{
+		auto *saved = b.getBuildPoint();
+		auto u64 = b.makeUintType(64), u32 = b.makeUintType(32), bit = b.makeBoolType();
+		spv::Block *entry;
+		Vector<spv::Id> params = {u64};
+		if (!read) params.push_back(payload_id);
+		auto *fn = b.makeFunctionEntry(spv::NoPrecision, read ? payload_id : b.makeVoidType(),
+		                               call.getCalledFunction()->getName().data(), params, {}, &entry);
+		b.setBuildPoint(entry);
+		auto storage = impl.options.inline_ubo_enable ? spv::StorageClassUniform : spv::StorageClassPushConstant;
+		auto load = [&](unsigned word) {
+			Vector<spv::Id> indices;
+			if (impl.root_constant_arrayed) indices.push_back(b.makeUintConstant(impl.root_descriptor_count));
+			indices.push_back(b.makeUintConstant(word + (impl.root_constant_arrayed ? 0 : impl.root_descriptor_count)));
+			return b.createLoad(b.createAccessChain(storage, impl.root_constant_id, indices));
+		};
+		auto guest = b.createUnaryOp(spv::OpBitcast, u64, b.createCompositeConstruct(b.makeVectorType(u32,2),
+		                       {load(impl.xbox_range_word), load(impl.xbox_range_word + 1)}));
+		auto bytes = b.createUnaryOp(spv::OpUConvert, u64, load(impl.xbox_range_word + 2));
+		auto addr = fn->getParamId(0), delta = b.createBinOp(spv::OpISub, u64, addr, guest);
+		auto width = b.makeUint64Constant(n * 4);
+		auto ok = b.createBinOp(spv::OpUGreaterThanEqual, bit, addr, guest);
+		auto require = [&](spv::Id x) { ok = b.createBinOp(spv::OpLogicalAnd, bit, ok, x); };
+		require(b.createBinOp(spv::OpUGreaterThanEqual, bit, bytes, width));
+		require(b.createBinOp(spv::OpULessThanEqual, bit, delta, b.createBinOp(spv::OpISub, u64, bytes, width)));
+		require(b.createBinOp(spv::OpIEqual, bit, b.createBinOp(spv::OpBitwiseAnd, u64, delta, b.makeUint64Constant(3)), b.makeUint64Constant(0)));
+		spv::Builder::If guard(ok, 0, b);
+		auto host = b.createUnaryOp(spv::OpBitcast, u64, b.createLoad(b.createAccessChain(storage, impl.root_constant_id,
+		                             {b.makeUintConstant(impl.xbox_range_descriptor)})));
+		auto type = n == 1 ? u32 : b.makeVectorType(u32, n);
+		auto ptr = b.createUnaryOp(spv::OpConvertUToPtr, b.makePointer(spv::StorageClassPhysicalStorageBuffer, type),
+		                           b.createBinOp(spv::OpIAdd, u64, host, delta));
+		spv::Id data;
+		if (read)
+		{
+			data = b.getUniqueId();
+			auto load_op = std::make_unique<spv::Instruction>(data, type, spv::OpLoad);
+			load_op->addIdOperand(ptr);
+			load_op->addImmediateOperand(spv::MemoryAccessAlignedMask);
+			load_op->addImmediateOperand(4);
+			b.getBuildPoint()->addInstruction(std::move(load_op));
+		}
+		else
+			data = fn->getParamId(1);
+		if (n > 1)
+		{
+			Vector<spv::Id> parts;
+			for (unsigned i = 0; i < n; i++) parts.push_back(b.createCompositeExtract(data, u32, i));
+			data = b.createCompositeConstruct(read ? payload_id : type, parts);
+		}
+		if (!read)
+		{
+			auto store = std::make_unique<spv::Instruction>(spv::OpStore);
+			store->addIdOperand(ptr); store->addIdOperand(data);
+			store->addImmediateOperand(spv::MemoryAccessAlignedMask); store->addImmediateOperand(4);
+			b.getBuildPoint()->addInstruction(std::move(store));
+		}
+		auto taken = b.getBuildPoint()->getId();
+		guard.makeEndIf();
+		b.makeReturn(true, read ? b.createOp(spv::OpPhi, payload_id,
+		             {data, taken, b.makeNullConstant(payload_id), entry->getId()}) : 0);
+		b.setBuildPoint(saved);
+		helper = fn->getId();
+	}
+	auto *op = read ? impl.allocate(spv::OpFunctionCall, &call) : impl.allocate(spv::OpFunctionCall, b.makeVoidType());
+	op->add_id(helper);
+	op->add_id(impl.get_id_for_value(call.getOperand(1)));
+	if (!read) op->add_id(impl.get_id_for_value(call.getOperand(2)));
+	impl.add(op);
+	return true;
+}
