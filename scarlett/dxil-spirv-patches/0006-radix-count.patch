+// Every ballot in this exact module is reached by all 512 lanes. Logical waves
+// use consecutive local invocation IDs, independent of native subgroup width.
+static bool emit_radix_count_wave(Converter::Impl &impl, const llvm::CallInst &call, unsigned opnum)
+{
+	auto u32 = [](const llvm::Type *t) { return t->isIntegerTy() && t->getIntegerBitWidth() == 32; };
+	auto &threads = impl.execution_mode_meta.workgroup_threads;
+	if (!impl.xbox_radix_count || impl.execution_model != spv::ExecutionModelGLCompute ||
+	    threads[0] != 512 || threads[1] != 1 || threads[2] != 1 || call.getNumOperands() != 2 ||
+	    !u32(call.getOperand(0)->getType()) || !u32(call.getOperand(1)->getType())) return false;
+	auto *opcode = llvm::dyn_cast<llvm::ConstantInt>(call.getOperand(0));
+	if (!opcode || opcode->getUniqueInteger().getZExtValue() != opnum) return false;
+	auto arg = impl.get_id_for_value(call.getOperand(1));
+	if (opnum == 50)
+	{
+		// Its only operand here is local_x >> 6, already logical-wave-uniform.
+		if (!u32(call.getType())) return false;
+		auto *op = impl.allocate(spv::OpCopyObject, &call); op->add_id(arg); impl.add(op);
+		return true;
+	}
+	auto *ty = call.getType();
+	if (ty->getTypeID() != llvm::Type::TypeID::StructTyID || ty->getStructNumElements() != 2 || !u32(ty->getStructElementType(0)) ||
+	    !u32(ty->getStructElementType(1))) return false;
+	auto &b = impl.builder();
+	auto t = b.makeUintType(32);
+	auto k = [&](unsigned n) { return b.makeUintConstant(n); };
+	auto emit = [&](spv::Op ins, spv::Id type, std::initializer_list<spv::Id> args) {
+		auto *op = type ? impl.allocate(ins, type) : impl.allocate(ins);
+		for (auto id : args) op->add_id(id);
+		impl.add(op); return op->id;
+	};
+	auto wg = k(spv::ScopeWorkgroup), sem = b.getWorkgroupBarrierSemanticsId();
+	auto barrier = [&]() { emit(spv::OpControlBarrier, 0, {wg, wg, sem}); };
+	// Independent 16-word scratch per static call (2 KiB total); no reuse races.
+	auto scratch = impl.create_variable(spv::StorageClassWorkgroup, b.makeArrayType(t,k(16),0), "BallotWords");
+	auto ptr = [&](spv::Id i) { return emit(spv::OpAccessChain,b.makePointer(spv::StorageClassWorkgroup,t),{scratch,i}); };
+	auto lane = emit(spv::OpLoad,t,{impl.spirv_module.get_builtin_shader_input(spv::BuiltInLocalInvocationIndex)});
+	auto word = emit(spv::OpShiftRightLogical,t,{lane,k(5)}), addr = ptr(word);
+	emit(spv::OpAtomicExchange,t,{addr,wg,k(0),k(0)}); barrier();
+	auto bit = emit(spv::OpBitwiseAnd,t,{lane,k(31)});
+	auto pred = emit(spv::OpINotEqual,b.makeBoolType(),{arg,k(0)});
+	auto mask = emit(spv::OpSelect,t,{pred,emit(spv::OpShiftLeftLogical,t,{k(1),bit}),k(0)});
+	emit(spv::OpAtomicOr,t,{addr,wg,k(0),mask}); barrier();
+	auto lo = emit(spv::OpBitwiseAnd,t,{word,k(~1u)});
+	auto *ret = impl.allocate(spv::OpCompositeConstruct,&call);
+	ret->add_id(emit(spv::OpLoad,t,{ptr(lo)}));
+	ret->add_id(emit(spv::OpLoad,t,{ptr(emit(spv::OpBitwiseOr,t,{lo,k(1)}))}));
+	impl.add(ret); return true;
+}
