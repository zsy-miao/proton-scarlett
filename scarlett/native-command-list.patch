     super::console_list::allocator_reset(p);
 }
+
+#[cfg(test)]
+#[test]
+#[ignore = "requires a D3D12 device and Proton; run alone for UMA accounting"]
+fn allocator_reset_and_teardown() {
+    use windows::Win32::Graphics::Direct3D::D3D_FEATURE_LEVEL_12_0;
+    unsafe {
+        let mut device: Option<ID3D12Device> = None;
+        D3D12CreateDevice(None, D3D_FEATURE_LEVEL_12_0, &mut device).unwrap();
+        let device = device.unwrap();
+        super::real::adopt(device.as_raw(), super::real::Kind::Device);
+        let mut p = std::ptr::null_mut();
+        let iid = super::layout::parse_guid("6102dee4-af59-4b09-b999-b44d73f09b24");
+        assert_eq!(super::device_x::create_command_allocator_x(device.as_raw(), 0, &iid, &mut p), 0);
+        let view = ID3D12CommandAllocator::from_raw(p);
+        let raw = native(p as usize) as *mut c_void;
+        assert_ne!(raw, p);
+        let held = ID3D12CommandAllocator::from_raw_borrowed(&raw).unwrap().clone();
+        let u = crate::gpu::uma::get().unwrap();
+        let before = u.used();
+        let hold = || {
+            let b = u.alloc(65536, 65536).unwrap();
+            super::console_list::hold_until_reset(raw as usize, vec![b as usize]);
+            assert_eq!(u.used(), before + 65536);
+        };
+        hold();
+        view.Reset().unwrap();
+        assert_eq!(u.used(), before);
+        hold();
+        drop(view);
+        assert_eq!(u.used(), before + 65536);
+        drop(held);
+        assert_eq!(u.used(), before);
+    }
+}
