+/// Only the title sees this view. The native fence's vtable is part of vkd3d's identity check.
+#[repr(C)]
+struct View {
+    vtable: *const usize,
+    pc: ID3D12Fence,
+    refs: std::sync::atomic::AtomicU32,
+    fence1: Option<windows::Win32::Graphics::Direct3D12::ID3D12Fence1>,
+}
+
+pub(super) fn view(pc: ID3D12Fence) -> *mut c_void {
+    static V: OnceLock<[usize; 13]> = OnceLock::new();
+    let v = V.get_or_init(|| {
+        let mut v = [0; 13];
+        for slot in 3..=9 {
+            v[slot] = super::title_list::forward(slot, std::mem::offset_of!(View, pc));
+        }
+        v[..3].copy_from_slice(&[qi as usize, add as usize, release as usize]);
+        v[10..].copy_from_slice(&[signal as usize, flags as usize, cell as usize]);
+        v
+    });
+    let fence1 = pc.cast().ok();
+    Box::into_raw(Box::new(View { vtable: v.as_ptr(), pc, refs: 1.into(), fence1 })).cast()
+}
+
+unsafe extern "system" fn qi(p: *mut View, iid: *const windows_core::GUID, out: *mut *mut c_void) -> i32 {
+    use windows::Win32::Graphics::Direct3D12::*;
+    if out.is_null() { return 0x80004003u32 as i32; }
+    *out = std::ptr::null_mut();
+    let Some(iid) = iid.as_ref() else { return 0x80004003u32 as i32 };
+    if [windows_core::IUnknown::IID, ID3D12Object::IID, ID3D12DeviceChild::IID, ID3D12Pageable::IID, ID3D12Fence::IID].contains(iid)
+        || (*iid == ID3D12Fence1::IID && (*p).fence1.is_some()) {
+        add(p);
+        *out = p.cast();
+        return 0;
+    }
+    crate::util::E_NOINTERFACE
+}
+unsafe extern "system" fn add(p: *mut View) -> u32 {
+    (*p).refs.fetch_add(1, Ordering::Relaxed) + 1
+}
+unsafe extern "system" fn release(p: *mut View) -> u32 {
+    let n = (*p).refs.fetch_sub(1, Ordering::AcqRel) - 1;
+    if n == 0 { drop(Box::from_raw(p)); }
+    n
+}
+unsafe extern "system" fn signal(p: *mut View, value: u64) -> i32 {
+    match (*p).pc.Signal(value) {
+        Ok(()) => { note_cpu_signal((*p).pc.as_raw() as usize); 0 }
+        Err(e) => e.code().0,
+    }
+}
+unsafe extern "system" fn flags(p: *mut View) -> i32 {
+    (*p).fence1.as_ref().map_or(0, |f| f.GetCreationFlags().0)
+}
+unsafe extern "system" fn cell(p: *mut View) -> *const u64 {
+    completed_value_address((*p).pc.as_raw())
+}
+
