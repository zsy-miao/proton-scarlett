+pub(super) unsafe extern "system" fn get_window_attribute(hwnd: *mut c_void, attr: u32, value: *mut c_void, size: u32) -> i32 {
+    let hr = DwmGetWindowAttribute(hwnd, attr, value, size);
+    if hr >= 0 && attr == 14 && !value.is_null() && size >= 4 &&
+        PROCS.lock().unwrap().iter().any(|&(h, _, clipped)| h == hwnd as usize && clipped) {
+        let mut bounds = std::mem::zeroed();
